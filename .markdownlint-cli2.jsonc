{
  // Lint all markdown except the trusted spec docs (see ignores).
  "globs": ["**/*.md", ".dev/**/*.md"],
  // Trusted spec docs are human-only and hook-protected; they are excluded so
  // style fixes can never mutate their content-hash (fix #4 / spec-drift).
  // They may still be formatted by hand; this only removes them from scope.
  // CONSTITUTION.md + ARCHITECTURE.md relocated under pharn/ (runtime-layout move); THREAT-MODEL.md +
  // LIMITS.md stay at root. pharn/floor/test-fixtures added alongside .dev/floor/test-fixtures (the
  // product fixtures relocated there; the variance fixture stayed under .dev/floor/test-fixtures).
  "ignores": [
    // Other Claude Code sessions' worktrees. They are git-excluded (.git/info/exclude), not tracked, so
    // this removes no repo file from lint coverage. Without it a bare `lint:md` in a main checkout reads
    // every nested worktree, including its node_modules, because every entry here matches ONLY at the
    // root: measured in a fixture holding this file, 5 files linted became 2. A `--fix` that went through
    // the globs above rewrote 124 files inside one of them (2026-09-23). The command-prescribed runs now
    // pass `--no-globs`, and this entry is the second layer behind that. Bound: it is tied to where Claude
    // Code places worktrees today. If that location moves, the entry silently matches nothing.
    ".claude/worktrees",
    // Codex's "import from Claude Code" output. `.gitignore` excludes it (`/.agents/`, beside `/AGENTS.md`
    // and `/.codex/`), so it is untracked and this removes no repo file from lint coverage. This tool does
    // not read `.gitignore`, and `**/*.md` descends into dot-directories. Each `.agents/skills/*/SKILL.md`
    // nests a whole command, H1 included, under the importer's own H1, so a bare `lint:md` in a checkout
    // holding the import went RED on MD025 once per file. The count is in CHANGELOG, not here, because the
    // importer decides it. Prettier needs no twin entry: it reads `.gitignore` by default. `/AGENTS.md`
    // linted clean and `/.codex/` held no markdown, so neither is listed. Bound: this matches only at the
    // root, as the `.gitignore` line does, and is tied to where the importer writes today.
    ".agents",
    "node_modules",
    ".dev/floor/test-fixtures",
    "pharn/floor/test-fixtures",
    "pharn/CONSTITUTION.md",
    "pharn/ARCHITECTURE.md",
    "THREAT-MODEL.md",
    "LIMITS.md",
    // Generated capability catalog (byte-for-byte output of `npm run docs:generate`, guarded by
    // .dev/floor/check-capability-catalog.mjs). Excluded so linting can never rewrite committed bytes
    // and make the drift checker see false drift.
    "docs/capabilities",
    // Generated lessons index (byte-for-byte output of `npm run docs:generate`, guarded by
    // .dev/floor/check-lessons-index.mjs). Excluded for the same reason as the catalog: linting must never
    // rewrite committed bytes and make the drift checker see false drift. L11 sharpens it — these gates are
    // whole-repo, so one stale byte here would block EVERY later feature's /pharn-dev-verify.
    "docs/lessons-index.md",
    // The PRODUCT lessons index (byte-for-byte output of `node pharn/floor/gen-lessons-index.mjs .`,
    // guarded by pharn/floor/check-lessons-index.mjs). Load-bearing, and VERIFIED LIVE rather than
    // assumed: markdownlint-cli2 DOES descend into dot-directories, so `**/*.md` matches `.pharn/**`
    // even though `.pharn/` is gitignored (a mis-formatted probe there produced MD019/MD030). Without
    // this entry a `--fix` pass would rewrite the cache, and the drift checker would then report STALE
    // over damage the linter itself caused. Prettier deliberately has no matching `.prettierignore`
    // entry: probed the same way, `prettier --check .` does NOT traverse `.pharn/`, so there is no
    // trigger for one (P7 — no speculative additions).
    ".pharn/lessons-index.md",
    // RUN-REPORT.md — deterministically rendered by pharn/floor/render-run-report.mjs, and it quotes
    // untrusted Handoff / PLAN `## Files` text VERBATIM, so no MD rule can be satisfied by construction
    // over content the renderer does not control. Excluded for the cost.json reason (L23): one writer
    // for a generated artifact, and no self-referential conflict with a gate /pharn-loop's own
    // /pharn-verify runs. Listed on reasoning, not after the first FAIL.
    "pharn/features/*/RUN-REPORT.md",
    // REGRESSION.md — the SAME reasoning as RUN-REPORT.md above (stage-regress-script, 6.23.0):
    // deterministically rendered by pharn/floor/render-regression.mjs from pharn/floor/stage-regress.mjs,
    // and it quotes a shelled checker's own message and a hostile gate id VERBATIM, so no MD rule can be
    // satisfied by construction over content the renderer does not control.
    "pharn/features/*/REGRESSION.md",
    // VERIFY.md — the SAME reasoning as REGRESSION.md above (stage-verify-script, 6.26.0): deterministically
    // rendered by pharn/floor/render-verify.mjs from pharn/floor/stage-verify.mjs, and it quotes gate ids,
    // PLAN-derived paths and a checker's own message VERBATIM, so no MD rule can be satisfied by construction
    // over content the renderer does not control.
    "pharn/features/*/VERIFY.md",
    // Zone note, kept where the next editor of this list will need it: `.pharn/` is excluded ENTRY BY
    // ENTRY, never as a blanket `.pharn/`. The reason is structural rather than situational — the
    // directory holds the fix #7 writes-scope file and the product-index cache above alongside
    // disposable per-command scratch (`.pharn/<command>/`), so a directory-wide waiver would stand over
    // load-bearing artifacts too, and it would merge two exclusions that exist for different reasons: a
    // generated artifact a `--fix` must not rewrite (above) versus human scratch that was never this
    // repo's markdown. Per-file entries of the second kind have been added here and later removed once
    // nothing under `.pharn/` matched them; re-adding one the next time `lint:md` reds on such a file is
    // the intended cycle, not a gap. ADVISORY: no checker reads this note, and none tests whether an
    // entry here still matches anything (named residual `lint-ignore-reachability-check`).
  ],
  "config": {
    "default": true,
    // Long-form specs use wide lines and occasional inline HTML.
    "MD013": false,
    "MD033": false,
    // Keep a Changelog repeats "Added"/"Changed"/etc. under each release; allow
    // duplicate headings unless they are siblings under the same parent.
    "MD024": { "siblings_only": true },
    // GitHub issue/PR templates are fragments that open with "##" sections, not a
    // document title, so the first-line-h1 rule does not apply.
    "MD041": false,
  },
}
